# Runtime styling provider: rules | openai | gemini | ollama
AI_PROVIDER=rules

# OpenAI Responses API: server-side only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Gemini: server-side only
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional local Ollama provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Payment provider: mock | prava
PAYMENT_PROVIDER=mock

# Prava Hosted Checkout: server-side secret only
PRAVA_SECRET_KEY=
PRAVA_BASE_URL=https://sandbox.api.prava.space
PRAVA_HOSTED_CHECKOUT_ORIGIN=https://sandbox.collect.prava.space

# Application and sandbox merchant
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MERCHANT_NAME=Fitora
DEMO_MERCHANT_URL=http://localhost:3000
DEMO_MERCHANT_COUNTRY_CODE=US

# Generate a strong random value locally; never commit the real value
CHECKOUT_SIGNING_SECRET=

# Server-only test switch; keep false in normal demos
DEMO_MERCHANT_FORCE_DECLINE=false
